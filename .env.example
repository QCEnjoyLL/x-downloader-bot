# Telegram Bot Token（从 @BotFather 获取）
BOT_TOKEN=your_bot_token_here

# 宿主机映射端口（Docker Compose 使用）：访问 http://宿主机:HOST_PORT
HOST_PORT=3000

# Bot 内部监听端口（直接 npm start/Docker CLI 时使用；Compose 内固定为 3000）
PORT=3000

# 轮询模式：无需公网 HTTPS，机器人主动拉取消息（推荐）
POLLING=true

# 上传成功后删除本地视频（默认 true）
# 设为 false 则保留所有下载的视频在 ./downloads 目录
CLEANUP_VIDEOS=true

# 多链接并发下载上限（默认 3）。视频会流式落盘并上传；
# 并发仍会增加带宽、磁盘和 CPU 压力（有效范围 1-10）
DOWNLOAD_CONCURRENCY=3

# 调试时记录完整 Telegram update/消息内容（可能包含隐私，生产环境保持 false）
DEBUG_UPDATES=false

# 直播回放(broadcasts)第三方解析兜底（可选）。yt-dlp 失败时启用。
# 需是一个返回内容里含直链 mp4 的接口，用 {url} 占位待解析的 X 链接，例如：
# BROADCAST_RESOLVER_URL=https://your-resolver.example/api?u={url}
BROADCAST_RESOLVER_URL=

# 默认禁止下载解析到本机/内网 IP 的 URL，防止 SSRF；仅在可信内网部署时开启
ALLOW_PRIVATE_DOWNLOADS=false

# 本地 Bot API（可选，突破 50MB 上传限制）
# 去 https://my.telegram.org/apps 创建应用获取
# 是否启用 API 容器：留空禁用；设为 local-api 启用
COMPOSE_PROFILES=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# 启用 API 容器时，同时设为 http://api:8081
TELEGRAM_API_URL=

# Webhook 模式安全配置（仅 POLLING=false 时需要）
# WEBHOOK_URL 必须是公网 HTTPS 完整地址，例如 https://bot.example.com/webhook
WEBHOOK_URL=
# 仅使用 A-Z、a-z、0-9、_、-，长度 1-256；建议随机生成
WEBHOOK_SECRET=
# 保护 /setup-webhook 管理入口，建议使用另一段随机字符串
WEBHOOK_SETUP_KEY=
