# Telegram Bot Token（从 @BotFather 获取）
BOT_TOKEN=your_bot_token_here

# 宿主机映射端口（Docker Compose 使用）：访问 http://宿主机:HOST_PORT
HOST_PORT=3000

# Bot 内部监听端口（直接 npm start/Docker CLI 时使用；Compose 内固定为 3000）
PORT=3000

# 轮询模式：无需公网 HTTPS，机器人主动拉取消息（推荐）
POLLING=true

# 上传成功后立即删除本地视频（默认 true）
# 设为 false 会保留到 ./downloads，但仍受下方 DOWNLOAD_RETENTION_HOURS 约束
CLEANUP_VIDEOS=true

# 所有消息共享的下载/上传并发上限（有效范围 1-10；默认同时处理 3 条）
DOWNLOAD_CONCURRENCY=3

# 持久化消息队列工作线程数（同一 Chat 也可并发），以及单个任务最大尝试次数
UPDATE_CONCURRENCY=8
JOB_MAX_ATTEMPTS=3

# 账户白名单（推荐）：逗号分隔 Telegram user ID；设置后仅这些账户可使用
ALLOWED_USER_IDS=
# 可选 Chat 白名单（主要用于允许整个群组）；账户白名单场景通常留空
ALLOWED_CHAT_IDS=
# 白名单用户默认不受下方请求频率和单消息链接数限制
ALLOWLIST_BYPASS_LIMITS=true

# 公开模式防滥用；设为 0 表示无限制
MAX_LINKS_PER_MESSAGE=5
MAX_REQUESTS_PER_MINUTE=10

# 下载目录生命周期与容量保护；保留时间设为 0 表示永久保留
DOWNLOAD_RETENTION_HOURS=24
MAX_DOWNLOAD_DISK_GB=20
MIN_FREE_DISK_GB=1

# 调试时记录完整 Telegram update/消息内容（可能包含隐私，生产环境保持 false）
DEBUG_UPDATES=false

# 直播回放(broadcasts)第三方解析兜底（可选）。yt-dlp 失败时启用。
# 需是一个返回内容里含直链 mp4 的接口，用 {url} 占位待解析的 X 链接，例如：
# BROADCAST_RESOLVER_URL=https://your-resolver.example/api?u={url}
BROADCAST_RESOLVER_URL=

# 默认禁止下载解析到本机/内网 IP 的 URL，防止 SSRF；仅在可信内网部署时开启
ALLOW_PRIVATE_DOWNLOADS=false

# 本地 Bot API（默认启用，上传上限约 2GB）
# 去 https://my.telegram.org/apps 创建应用获取
# 默认启动 API 容器；如需改用官方 API（50MB），将此项留空
COMPOSE_PROFILES=local-api
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# 可选覆盖；留空时会根据 COMPOSE_PROFILES 自动选择官方或本地 API
TELEGRAM_API_URL=

# Webhook 模式安全配置（仅 POLLING=false 时需要）
# WEBHOOK_URL 必须是公网 HTTPS 完整地址，例如 https://bot.example.com/webhook
WEBHOOK_URL=
# 仅使用 A-Z、a-z、0-9、_、-，长度 1-256；建议随机生成
WEBHOOK_SECRET=
# 保护 /setup-webhook 管理入口，建议使用另一段随机字符串
WEBHOOK_SETUP_KEY=
